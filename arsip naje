export default function CODCalculator() {
  const [blanko, setBlanko] = React.useState(0);
  const [sampel, setSampel] = React.useState(0);
  const [normalitas, setNormalitas] = React.useState(0.1);
  const [volume, setVolume] = React.useState(10);
  const [hasil, setHasil] = React.useState(null);

  const hitungCOD = () => {
    const cod = ((blanko - sampel) * normalitas * 8000) / volume;
    setHasil(cod.toFixed(2));
  };

  return (
    <div className="min-h-screen bg-slate-100 flex items-center justify-center p-6">
      <div className="bg-white shadow-2xl rounded-3xl p-8 w-full max-w-md">
        <h1 className="text-3xl font-bold text-center mb-6">
          Kalkulator COD
        </h1>

        <div className="space-y-4">
          <div>
            <label className="block mb-1 font-medium">
              Volume Blanko (mL)
            </label>
            <input
              type="number"
              value={blanko}
              onChange={(e) => setBlanko(parseFloat(e.target.value))}
              className="w-full border rounded-xl p-3"
            />
          </div>

          <div>
            <label className="block mb-1 font-medium">
              Volume Sampel (mL)
            </label>
            <input
              type="number"
              value={sampel}
              onChange={(e) => setSampel(parseFloat(e.target.value))}
              className="w-full border rounded-xl p-3"
            />
          </div>

          <div>
            <label className="block mb-1 font-medium">
              Normalitas FAS
            </label>
            <input
              type="number"
              value={normalitas}
              onChange={(e) => setNormalitas(parseFloat(e.target.value))}
              className="w-full border rounded-xl p-3"
            />
          </div>

          <div>
            <label className="block mb-1 font-medium">
              Volume Sampel Air (mL)
            </label>
            <input
              type="number"
              value={volume}
              onChange={(e) => setVolume(parseFloat(e.target.value))}
              className="w-full border rounded-xl p-3"
            />
          </div>

          <button
            onClick={hitungCOD}
            className="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-2xl transition"
          >
            Hitung COD
          </button>
        </div>

        {hasil && (
          <div className="mt-6 bg-slate-100 rounded-2xl p-4 text-center">
            <p className="text-lg font-medium">Hasil COD</p>
            <p className="text-3xl font-bold text-blue-700 mt-2">
              {hasil} mg/L
            </p>
          </div>
        )}

        <div className="mt-6 text-sm text-slate-600">
          <p className="font-semibold mb-1">Rumus COD:</p>
          <p>
            COD = ((Blanko − Sampel) × N × 8000) / Volume Sampel
          </p>
        </div>
      </div>
    </div>
  );
}
